<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Agamemnon's protection helper, registered with SMAppService from inside the app.
	     See Helper/main.swift and App/Services/SelfProtection.swift. -->
	<key>Label</key>
	<string>com.mirazbakis.Agamemnon.Helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/AgamemnonHelper</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.mirazbakis.Agamemnon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
